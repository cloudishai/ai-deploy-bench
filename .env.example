# Copy to .env (gitignored), fill in, then run scripts/set-secrets.sh.
# See docs/setup.md for how to create each key and what each account needs.

# Model provider: used by Claude Code in every cell.
ANTHROPIC_API_KEY=

# Clouds: each is only exposed to that cloud's deploy, inventory and teardown steps. Creating them
# is a human step the benchmark counts (docs/methodology.md). Cloudish needs none: agents mint
# their own keys.
DIGITALOCEAN_ACCESS_TOKEN=
RENDER_API_KEY=
VERCEL_TOKEN=
RAILWAY_API_TOKEN=

# Optional help for clouds that deploy only from Git or a container registry: a GitHub account or
# organization where agents may create scratch repositories and images. Providing it is a human
# step, counted for every deployment that uses it. Use a classic token with the repo, delete_repo,
# write:packages and delete:packages scopes.
BENCH_GITHUB_TOKEN=
BENCH_GITHUB_OWNER=

# Optional, stored as variables: only needed when a token can see several teams or workspaces.
VERCEL_TEAM_ID=
RENDER_OWNER_ID=
